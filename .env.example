# Database configuration
# Leave DATABASE_URL blank to use the writable local/Docker SQLite runtime DB.
# For persistent production data, set this in deployment secret storage.
# DATABASE_URL=sqlite:///.runtime/trade_intelligence.db
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost/dbname

# Frontend API configuration
API_BASE=http://127.0.0.1:8001
APP_MODE=demo
PUBLIC_BASE_URL=http://127.0.0.1:8502
CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
# Larger values reduce backend refresh pressure during demos.
# AI_LIVE_REFRESH_SECONDS=2.5
# PRODUCTION_MODE=false
# ALLOW_DEMO_ACCOUNTS_IN_PRODUCTION=false
AUTH_MODE=local role simulation
AUTH_DEMO_SALT=replace_with_local_demo_salt
# Optional production identity providers. Never put real secrets in the repo.
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
# INSTAGRAM_CLIENT_ID=your_instagram_client_id
# INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
# APPLE_CLIENT_ID=your_apple_services_id
# APPLE_TEAM_ID=your_apple_team_id
# APPLE_KEY_ID=your_apple_key_id
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret
# MICROSOFT_CLIENT_ID=your_microsoft_client_id
# MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# OIDC_ISSUER=https://issuer.example.com
# OIDC_CLIENT_ID=your_oidc_client_id
# OIDC_CLIENT_SECRET=your_oidc_client_secret
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://127.0.0.1:8502

# Optional real AIS stream. Keep real keys in .env only.
# AIS_PROVIDER=aisstream
# AISSTREAM_API_KEY=your_aisstream_key
# AISSTREAM_MAX_VESSELS=12
# AISSTREAM_STALE_SECONDS=900
# AIS map movement uses true API position plus speed/heading/signal-age projection.
# Raise multiplier only for a more dramatic classroom demo.
# AISSTREAM_MAP_MOTION_MULTIPLIER=90
# AISSTREAM_MOTION_WINDOW_SECONDS=90
# AISSTREAM_MAX_PROJECTED_NM=35
# AISSTREAM_DEMO_EXAGGERATED_MOTION=false
# AISSTREAM_BOUNDING_BOXES=[[[0.7,100.8],[1.8,104.4]]]
# Local demo only: use if AISStream websocket certificate verification fails.
AISSTREAM_ALLOW_INSECURE_SSL=false

# Optional production risk/data providers. Leave blank for transparent demo fallback.
# WEATHER_API_KEY=your_weather_provider_key
# PORT_CONGESTION_API_KEY=your_port_congestion_key
# MARITIME_SECURITY_API_KEY=your_maritime_security_key
# GEOPOLITICAL_RISK_API_KEY=your_geopolitical_risk_key
# FUEL_PRICE_API_KEY=your_fuel_price_key
# CONTAINER_TRACKING_API_KEY=your_container_tracking_key
# SEA_LANE_PROVIDER_API_KEY=your_nautical_route_engine_key
# MAP_TILE_PROVIDER_KEY=your_weather_or_3d_map_tile_key
# ML_TRAINING_DATASET_PATH=data/historical_maritime_risk.csv

# Optional production alert delivery channels.
# NOTIFICATION_WEBHOOK_URL=https://example.com/webhook
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_FROM=alerts@example.com
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# SMS_PROVIDER_API_KEY=your_sms_provider_key
# PUSH_PROVIDER_KEY=your_mobile_push_key

# Optional company operations metadata.
# ORG_WORKSPACE_NAME=Maritime Command Workspace
