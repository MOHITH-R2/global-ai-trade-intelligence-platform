# Required production mode controls
APP_MODE=production
PRODUCTION_MODE=true
ALLOW_DEMO_ACCOUNTS_IN_PRODUCTION=false

# Public deployed origins
PUBLIC_BASE_URL=https://your-frontend.example.com
FRONTEND_BASE_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com
API_BASE=https://your-backend.example.com

# Persistent database
# Use your provider's internal PostgreSQL URL when available.
DATABASE_URL=postgresql://username:password@host:5432/database

# Authentication/session hardening
AUTH_MODE=external_oidc_webauthn
AUTH_DEMO_SALT=replace_with_a_long_random_secret_from_secret_storage

# Optional AISStream live vessel provider
AIS_PROVIDER=aisstream
AISSTREAM_API_KEY=replace_with_secret_storage_value
AISSTREAM_MAX_VESSELS=12
AISSTREAM_STALE_SECONDS=900
AISSTREAM_ALLOW_INSECURE_SSL=false

# Optional external auth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# WEBAUTHN_RP_ID=your-frontend.example.com
# WEBAUTHN_ORIGIN=https://your-frontend.example.com

# Optional alert delivery providers
# NOTIFICATION_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
# EMAIL_FROM=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMS_PROVIDER_API_KEY=
